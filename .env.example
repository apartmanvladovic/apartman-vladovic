# ─── Email (obavezno za slanje upita) ────────────────────────────────────
# Opcija A — Resend (preporučeno, besplatno do 100 emailova/dan):
#   1. Napravi nalog na https://resend.com
#   2. Generiši API ključ i zalijepi ga ispod
RESEND_API_KEY=
# Za test radi i "Apartman Vladović <onboarding@resend.dev>".
# Za produkciju verifikuj svoju domenu u Resendu i stavi npr:
# EMAIL_FROM="Apartman Vladović <rezervacije@tvojadomena.com>"
EMAIL_FROM="Apartman Vladović <onboarding@resend.dev>"

# Opcija B — Nodemailer / Gmail App Password (alternativa Resendu):
#   1. Uključi 2FA na Gmail nalogu
#   2. Kreiraj App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=apartmanvladovic@gmail.com
# SMTP_PASS=app-password-od-16-znakova

# Primaoc upita (po defaultu iz site config-a).
CONTACT_EMAIL=apartmanvladovic@gmail.com

# ─── Kalendar (opcionalno) ────────────────────────────────────────────────
# Airbnb/Booking iCal export linkovi, odvojeni zarezom.
# Ako je prazno, kalendar čita samo data/bookedDates.json.
ICAL_FEED_URLS=

# ─── SEO (opcionalno) ─────────────────────────────────────────────────────
# Javni URL sajta (za OpenGraph). Na Vercelu: https://tvoj-sajt.vercel.app
NEXT_PUBLIC_SITE_URL=
