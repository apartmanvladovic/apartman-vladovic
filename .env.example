# ─── Email (opcionalno — bez ovoga forma nudi WhatsApp fallback) ─────────
# Primaoc upita sa forme (obavezno ako želite email dostavu).
CONTACT_EMAIL=apartmanvladovic@gmail.com

# Opcija A — Resend (https://resend.com, besplatno do 100 emailova/dan):
RESEND_API_KEY=
EMAIL_FROM="Vikendica AQUA <onboarding@resend.dev>"

# Opcija B — Gmail App Password (Nodemailer):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=vas-email@gmail.com
# SMTP_PASS=app-password-od-16-znakova

# ─── SEO (opcionalno) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ─── Admin chat (/admin) — uređivanje sadržaja preko Gemini AI ──────────
# Auth.js tajni ključ za potpisivanje sesija (generišite: npx auth secret)
AUTH_SECRET=

# Google OAuth klijent (Google Cloud Console → Credentials → OAuth client ID,
# Authorized redirect URI: https://VASA-DOMENA/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Jedini Google email kojem je dozvoljen pristup /admin (ostali dobijaju 403)
ADMIN_ALLOWED_EMAIL=apartmanvladovic@gmail.com

# Na Vercelu obavezno postaviti (Auth.js iza proxy-ja):
# AUTH_TRUST_HOST=true

# Gemini API ključ (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# GitHub fine-grained token sa Contents: Read & Write na repo sajta
# (https://github.com/settings/personal-access-tokens)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main
